{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bpaikportal",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-24",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "FIREBASE_PROJECT_ID": "bpaik-portal-auth-2026"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pbaik-absensi-data",
      "database_id": "6692fd65-4ae3-4837-89ec-fc76760e9f77",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "bpaik-participant-photos"
    }
  ]
}
